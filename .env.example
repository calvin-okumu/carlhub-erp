# DjangoCRM Environment Configuration Template
# Copy this file to .env and update values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Shared database configuration for all services
DB_HOST=localhost
DB_PORT=5432
DB_USER=django_microservices
DB_PASSWORD=your_secure_password_here

# Database names (automatically created)
# identity_db, audit_db, notification_db, accounting_db, hr_db, project_db, sales_db

# =============================================================================
# TRAEFIK API GATEWAY
# =============================================================================
TRAEFIK_ENABLED=true
API_GATEWAY_URL=http://localhost:8000

# =============================================================================
# SERVICE URLs
# =============================================================================
IDENTITY_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8003
ACCOUNTING_SERVICE_URL=http://localhost:8004
HR_SERVICE_URL=http://localhost:8005
PROJECT_SERVICE_URL=http://localhost:8006
SALES_SERVICE_URL=http://localhost:8007

# =============================================================================
# MESSAGE QUEUE (Future Use - Event Bus)
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# =============================================================================
# CACHE (Future Use)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# MONITORING
# =============================================================================
# Prometheus metrics port per service
# Identity Service: http://localhost:8002
# Audit Service: http://localhost:8003
# Notification Service: http://localhost:8004
# Accounting Service: http://localhost:8005
# HR Service: http://localhost:8006
# Project Service: http://localhost:8007
# Sales Service: http://localhost:8008

# =============================================================================
# FRONTEND
# =============================================================================
# Next.js frontend
NEXT_PUBLIC_TRAEFIK_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# EMAIL (Shared across services)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@djangocrm.com
SITE_NAME=DjangoCRM
FRONTEND_URL=http://localhost:3000
FRONTEND_CONFIRMATION_PATH=/confirm-invitation
FRONTEND_SIGNUP_PATH=/signup
SITE_URL=http://localhost:8000

# =============================================================================
# DEBUG MODE
# =============================================================================
# Set to True in development, False in production
DEBUG=true

# =============================================================================
# SECRET KEYS
# =============================================================================
# WARNING: Change these in production!
IDENTITY_SECRET_KEY=django-insecure-identity-service-secret-key-2024
AUDIT_SECRET_KEY=django-insecure-audit-service-secret-key-2024
NOTIFICATION_SECRET_KEY=django-insecure-notification-service-secret-key-2024
ACCOUNTING_SECRET_KEY=django-insecure-accounting-service-secret-key-2024
HR_SECRET_KEY=django-insecure-hr-service-secret-key-2024
PROJECT_SECRET_KEY=django-insecure-project-service-secret-key-2024
SALES_SECRET_KEY=django-insecure-sales-service-secret-key-2024

# =============================================================================
# ADDITIONAL NOTES
# =============================================================================
# 1. Create PostgreSQL databases:
#    - su - postgres
#    - psql
#    - CREATE DATABASE identity_db;
#    - (repeat for all services)
#
# 2. Run migrations for each service:
#    - cd services/<service>-service
#    - source venv/bin/activate
#    - python manage.py makemigrations
#    - python manage.py migrate
#
# 3. Service-specific .env files:
#    - Each service has its own .env in its directory
#    - These override root-level values if needed
#
# 4. Admin access via subdomains:
#    - http://admin.identity.localhost:8000/admin/
#    - http://admin.project.localhost:8000/admin/
#    - etc.
#
# 5. API access via Traefik gateway:
#    - http://localhost:8000/api/v1/identity/health/
#    - http://localhost:8000/api/v1/project/health/
#    - etc.
